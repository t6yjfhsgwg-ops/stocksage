# Frontend (Vite) — optional; leave empty on Vercel (uses same-origin /api)
# VITE_API_URL=https://your-app.vercel.app
VITE_USE_MARKET_API=true

# Vercel serverless /api/chart — comma-separated origins, or * for demo
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Optional: future server-side Claude proxy (do NOT put Anthropic keys in VITE_*)
# ANTHROPIC_API_KEY=sk-ant-...
